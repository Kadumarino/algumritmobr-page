# Copie este arquivo para ".env" (não versionado) e preencha com os dados do
# seu projeto Supabase (Project Settings > API). A "anon key" é pública por
# design (protegida pelas policies de RLS em supabase/schema.sql) — mas mesmo
# assim mantenha o .env fora do git, como já está no .gitignore.
PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=SUA-ANON-KEY-AQUI
