---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/site';

const blocos = (await getCollection('repertorio')).sort((a, b) => a.data.ordem - b.data.ordem);
---

<BaseLayout
  title="Repertório"
  description="Repertório do projeto Algum Ritmo organizado por década, playlist do Spotify e Instagram."
>
  <section class="section">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Repertório</span>
        <h1>Um repertório para cada momento</h1>
        <p>
          O show é dividido em duas partes, cada uma com uma formação e um recorte de décadas
          diferente. Confira uma amostra do repertório abaixo.
        </p>
      </div>

      {
        blocos.map((bloco) => (
          <div class="repertorio-bloco">
            <div class="repertorio-bloco-header">
              <h2>{bloco.data.parte}</h2>
              <p>{bloco.data.formacao}</p>
            </div>
            <div class="repertorio-decadas">
              {bloco.data.decadas.map((decada) => (
                <div class="decada-card card">
                  <h4>{decada.decada}</h4>
                  <ul>
                    {decada.musicas.map((musica) => (
                      <li>
                        <div class={`musica-row ${musica.spotifyId ? 'is-playable' : ''}`}>
                          <div class="musica-info">
                            <span class="titulo">{musica.titulo}</span>
                            <span class="artista">{musica.artista}</span>
                          </div>
                          {musica.spotifyId && (
                            <button
                              type="button"
                              class="play-btn"
                              data-spotify-id={musica.spotifyId}
                              aria-expanded="false"
                              aria-label={`Tocar ${musica.titulo} no Spotify`}
                            >
                              <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M8 5v14l11-7z"></path>
                              </svg>
                            </button>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }

      <p style="text-align:center; font-size:0.9rem;">
        {/* TODO: repertório completo com as músicas reais — enviar lista final para atualização. */}
        Lista acima é uma amostra. O repertório completo é adaptado conforme o perfil do evento.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Ouça Agora</span>
        <h2>Playlist no Spotify</h2>
      </div>
      <div class="embed-wrap">
        <iframe
          src={`https://open.spotify.com/embed/playlist/${siteConfig.spotifyPlaylistId}?utm_source=generator&theme=0`}
          height="380"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          title="Playlist Algum Ritmo no Spotify"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="instagram-cta">
        <h2>Acompanhe nos bastidores</h2>
        <p>
          Siga o Algum Ritmo no Instagram e no YouTube para ver vídeos, próximos eventos e
          bastidores dos shows.
        </p>
        <div class="hero-actions" style="justify-content:center;">
          <a
            class="btn btn-outline--dark"
            href={siteConfig.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Seguir {siteConfig.instagramHandle}
          </a>
          <a
            class="btn btn-outline--dark"
            href={siteConfig.youtubeUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver no YouTube
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>
<script>
  // Cada linha tem um player do Spotify: 1º clique no play cria o player e toca; clicar
  // de novo no play pausa/retoma; clicar no nome da música recolhe (fecha) o widget.
  // Só uma linha fica com o player aberto por vez.
  const VALID_ID = /^[a-zA-Z0-9]+$/;

  let spotifyApi: any = null;
  const apiReady = new Promise<any>((resolve) => {
    (window as any).onSpotifyIframeApiReady = (IFrameAPI: any) => {
      spotifyApi = IFrameAPI;
      resolve(IFrameAPI);
    };
  });

  type PlayerState = { wrapper: HTMLElement; controller: any; isPaused: boolean };
  const players = new Map<HTMLElement, PlayerState>();
  let activeRow: HTMLElement | null = null;

  function closePlayer(row: HTMLElement) {
    const state = players.get(row);
    if (!state) return;
    state.controller?.destroy();
    state.wrapper.remove();
    players.delete(row);
    const btn = row.querySelector<HTMLButtonElement>('.play-btn');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.classList.remove('is-active');
    if (activeRow === row) activeRow = null;
  }

  document.querySelectorAll<HTMLLIElement>('.decada-card li').forEach((row) => {
    const btn = row.querySelector<HTMLButtonElement>('.play-btn');
    const info = row.querySelector<HTMLElement>('.musica-info');
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const state = players.get(row);
      if (state) {
        if (state.isPaused) {
          state.controller.resume();
        } else {
          state.controller.pause();
        }
        return;
      }

      if (activeRow && activeRow !== row) {
        closePlayer(activeRow);
      }

      const trackId = btn.dataset.spotifyId ?? '';
      if (!VALID_ID.test(trackId)) return;

      // O elemento passado pro createController é substituído pelo iframe do Spotify,
      // por isso usamos um wrapper estável por fora + um alvo descartável por dentro.
      const wrapper = document.createElement('div');
      wrapper.className = 'spotify-player';
      const target = document.createElement('div');
      wrapper.appendChild(target);
      row.appendChild(wrapper);
      btn.setAttribute('aria-expanded', 'true');
      btn.classList.add('is-active');
      activeRow = row;

      const IFrameAPI = spotifyApi ?? (await apiReady);
      IFrameAPI.createController(
        target,
        { uri: `spotify:track:${trackId}`, width: '100%', height: 80 },
        (EmbedController: any) => {
          const state: PlayerState = { wrapper, controller: EmbedController, isPaused: false };
          players.set(row, state);
          EmbedController.addListener('ready', () => {
            EmbedController.play();
          });
          EmbedController.addListener('playback_update', (e: any) => {
            state.isPaused = Boolean(e?.data?.isPaused);
          });
        },
      );
    });

    info?.addEventListener('click', () => {
      if (players.has(row)) closePlayer(row);
    });
  });
</script>

