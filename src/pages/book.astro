---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Book"
  description="Fotos e vídeos do duo Algum Ritmo em apresentações — direto do Instagram."
>
  <section class="section">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Book</span>
        <h1>Fotos e vídeos dos shows</h1>
        <p>Um pouco do que é viver a experiência Algum Ritmo ao vivo, direto do nosso Instagram.</p>
      </div>

      <div id="book-pinned" class="grid grid--3 book-grid"></div>

      <div class="section-title book-subtitle">
        <h2>Últimos vídeos</h2>
      </div>
      <div id="book-videos" class="grid grid--3 book-grid"></div>

      <div class="section-title book-subtitle">
        <h2>Fotos</h2>
      </div>
      <div id="book-fotos" class="grid grid--3 book-grid"></div>

      <p id="book-msg" class="form-msg" role="status" />
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase, supabaseEnabled, type BookPost } from '../lib/supabase';

  // Garante que só um vídeo toca por vez: ao iniciar um, pausa o que estava tocando.
  let videoTocando: HTMLVideoElement | null = null;

  function criarCard(post: BookPost): HTMLDivElement {
    const card = document.createElement('div');
    card.className = 'book-card';

    const media = document.createElement('div');
    media.className = 'book-card-media';
    card.appendChild(media);

    if (post.tipo === 'video' && post.video_url) {
      const video = document.createElement('video');
      video.controls = true;
      video.preload = 'metadata';
      video.setAttribute('playsinline', '');
      video.poster = post.thumbnail_url;
      const source = document.createElement('source');
      source.src = post.video_url;
      source.type = 'video/mp4';
      video.appendChild(source);
      media.appendChild(video);

      video.addEventListener('play', () => {
        if (videoTocando && videoTocando !== video) {
          videoTocando.pause();
        }
        videoTocando = video;
      });

      // Primeiro clique ou Enter/Espaço (com o card focado) já inicia a reprodução.
      // O listener roda só uma vez para não atrapalhar os controles nativos (pause, volume etc).
      media.tabIndex = 0;
      media.setAttribute('role', 'button');
      media.setAttribute('aria-label', post.titulo ? `Reproduzir vídeo: ${post.titulo}` : 'Reproduzir vídeo');
      media.addEventListener(
        'click',
        () => {
          video.play().catch((err) => {
            console.error('[book] Falha ao reproduzir vídeo. video_url pode estar expirada:', post.video_url, err);
          });
        },
        { once: true }
      );
      media.addEventListener(
        'keydown',
        (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            video.play().catch((err) => {
              console.error('[book] Falha ao reproduzir vídeo. video_url pode estar expirada:', post.video_url, err);
            });
          }
        },
        { once: true }
      );
      video.addEventListener('error', () => {
        console.error('[book] Erro ao carregar vídeo (URL expirada/CORS?):', post.video_url, video.error);
      });
    } else {
      const img = document.createElement('img');
      img.src = post.thumbnail_url;
      img.loading = 'lazy';
      img.alt = post.titulo || 'Publicação do Instagram — Algum Ritmo';
      media.appendChild(img);
    }

    const badge = document.createElement('span');
    badge.className = 'book-badge';
    badge.setAttribute('aria-hidden', 'true');
    badge.innerHTML =
      post.tipo === 'video'
        ? '<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>'
        : '<svg viewBox="0 0 24 24"><path d="M4 8a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8z"/><path d="M8 4h9a2 2 0 0 1 2 2v9" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
    media.appendChild(badge);

    if (post.titulo) {
      const legenda = document.createElement('span');
      legenda.className = 'book-legenda';
      legenda.textContent = post.titulo;
      media.appendChild(legenda);
    }

    // Barra de ações estilo Instagram (curtidas e comentários), abaixo da mídia.
    const acoes = document.createElement('div');
    acoes.className = 'book-card-actions';
    acoes.innerHTML = `
      <span class="book-action">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.7-4.35-9.33-8.4C1.02 9.28 2.1 5.6 5.6 4.7c2-.52 4 .3 5.1 2 .1.15.2.15.3 0 1.1-1.7 3.1-2.52 5.1-2 3.5.9 4.58 4.58 2.93 7.9C18.7 16.65 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        ${post.like_count ?? 0}
      </span>
      <span class="book-action">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12c0 4.418-4.03 8-9 8-1.06 0-2.07-.16-3-.46L3 21l1.6-4.8A7.94 7.94 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        ${post.comments_count ?? 0}
      </span>
      <a class="book-action book-action--link" href="${post.instagram_url}" target="_blank" rel="noopener noreferrer">Ver no Instagram</a>
    `;
    card.appendChild(acoes);

    return card;
  }

  async function carregarBook() {
    const pinnedEl = document.getElementById('book-pinned');
    const videosEl = document.getElementById('book-videos');
    const fotosEl = document.getElementById('book-fotos');
    const msg = document.getElementById('book-msg');
    if (!pinnedEl || !videosEl || !fotosEl) return;

    if (!supabaseEnabled || !supabase) {
      if (msg) msg.textContent = 'Galeria indisponível no momento.';
      return;
    }

    const { data, error } = await supabase
      .from('book_posts')
      .select('*')
      .order('created_at', { ascending: false });

    if (error || !data) {
      if (msg) msg.textContent = 'Não foi possível carregar a galeria.';
      return;
    }

    const posts = data as BookPost[];
    const pinned = posts.filter((post) => post.pinned);
    const videos = posts.filter((post) => !post.pinned && post.tipo === 'video').slice(0, 6);
    const fotos = posts.filter((post) => !post.pinned && post.tipo === 'foto').slice(0, 3);

    pinned.forEach((post) => pinnedEl.appendChild(criarCard(post)));
    videos.forEach((post) => videosEl.appendChild(criarCard(post)));
    fotos.forEach((post) => fotosEl.appendChild(criarCard(post)));
  }

  carregarBook();
</script>

