---
import BaseLayout from '../layouts/BaseLayout.astro';
import instagramPosts from '../data/instagram-posts.json';
---

<BaseLayout
  title="Book"
  description="Fotos e vídeos do duo Algum Ritmo em apresentações — direto do Instagram."
>
  <section class="section">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Book</span>
        <h1>Fotos e vídeos dos shows</h1>
        <p>Um pouco do que é viver a experiência Algum Ritmo ao vivo, direto do nosso Instagram.</p>
      </div>

      <div class="instagram-grid">
        {
          instagramPosts.map((post) => (
            <blockquote
              class="instagram-media"
              data-instgrm-permalink={post.url}
              data-instgrm-version="14"
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script async src="https://www.instagram.com/embed.js" is:inline></script>
