---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import videosData from '../data/videos.json';

const base = import.meta.env.BASE_URL;
const heroYoutubeId = 'HUBEsOYtC4w';
---

<BaseLayout title="Início" description={siteConfig.descricaoCurta}>
  <section class="hero">
    <div class="hero-media">
      <iframe
        id="yt-player-hero"
        src={`https://www.youtube.com/embed/${heroYoutubeId}?autoplay=1&mute=1&loop=1&playlist=${heroYoutubeId}&controls=1&modestbranding=1&rel=0&enablejsapi=1`}
        title="Vídeo de apresentação — Algum Ritmo"
        allow="autoplay; encrypted-media"
      ></iframe>
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content container">
      <span class="eyebrow">Projeto Acústico</span>
      <h1>{siteConfig.nome}</h1>
      <p class="hero-tagline">Levando a música além!</p>
      <p class="hero-description">
        Shows para hotéis, casas noturnas e eventos exclusivos, com repertório dos anos 60 aos
        dias atuais — e a marca registrada do projeto: a troca de papéis ao vivo entre os
        músicos.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}contato/`}>Solicitar Orçamento</a>
        <a class="btn btn-outline" href={`${base}repertorio/`}>Ver Repertório</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">O Diferencial</span>
        <h2>Um show, duas experiências</h2>
      </div>
      <div class="grid grid--3">
        <div class="card">
          <h3>Troca de Papéis</h3>
          <p>
            Na primeira parte, um músico assume o violão, o vocal principal e a primeira voz,
            enquanto o parceiro toca cajon e faz a segunda voz. Na segunda parte, os papéis se
            invertem por completo.
          </p>
        </div>
        <div class="card">
          <h3>Repertório por Décadas</h3>
          <p>
            Dos anos 60 aos sucessos atuais, um repertório cuidadosamente construído para o
            clima de cada evento.
          </p>
        </div>
        <div class="card">
          <h3>Tipos de Eventos</h3>
          <p>
            Anos de mercado em hotéis, casas noturnas e celebrações festivas e muito mais.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-title">
        <span class="eyebrow">Vídeos</span>
        <h2>Momentos ao vivo</h2>
      </div>
      <div class="video-grid">
        {
          videosData.videos.map((video, index) => (
            <div class="video-item">
              <iframe
                id={`yt-player-${index}`}
                src={`https://www.youtube.com/embed/${video.youtubeId}?enablejsapi=1`}
                title={video.titulo}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
              <p>{video.titulo}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container" style="text-align:center;">
      <h2>Pronto para elevar o seu evento?</h2>
      <p>
        Solicite um orçamento sem compromisso e leve a experiência Algum Ritmo para o seu hotel,
        casa noturna ou celebração.
      </p>
      <a class="btn btn-primary" href={`${base}contato/`}>Fale Conosco</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Garante que, ao dar play em um vídeo do YouTube, os demais vídeos da página pausem automaticamente.
  let heroPlayer: any = null;

  function unmuteHeroOnFirstInteraction() {
    if (heroPlayer && typeof heroPlayer.unMute === 'function') {
      heroPlayer.unMute();
      heroPlayer.setVolume(100);
    }
    window.removeEventListener('click', unmuteHeroOnFirstInteraction);
    window.removeEventListener('touchstart', unmuteHeroOnFirstInteraction);
    window.removeEventListener('keydown', unmuteHeroOnFirstInteraction);
    window.removeEventListener('scroll', unmuteHeroOnFirstInteraction);
  }

  window.addEventListener('click', unmuteHeroOnFirstInteraction);
  window.addEventListener('touchstart', unmuteHeroOnFirstInteraction);
  window.addEventListener('keydown', unmuteHeroOnFirstInteraction);
  window.addEventListener('scroll', unmuteHeroOnFirstInteraction, { once: true, passive: true });

  function initYouTubePlayers() {
    const iframes = document.querySelectorAll<HTMLIFrameElement>('iframe[id^="yt-player-"]');
    if (!iframes.length) return;

    const players: any[] = [];

    iframes.forEach((iframe) => {
      const player = new (window as any).YT.Player(iframe.id, {
        events: {
          onReady: (event: any) => {
            if (iframe.id === 'yt-player-hero') {
              // Navegadores só permitem autoplay com som se o visitante já tiver interagido
              // com a página. Começamos mudo para garantir o autoplay e ativamos o som
              // automaticamente assim que houver qualquer clique, toque, tecla ou rolagem.
              heroPlayer = event.target;
              event.target.mute();
              event.target.playVideo();
            }
          },
          onStateChange: (event: any) => {
            if (event.data === (window as any).YT.PlayerState.PLAYING) {
              players.forEach((otherPlayer) => {
                if (otherPlayer !== player && typeof otherPlayer.pauseVideo === 'function') {
                  otherPlayer.pauseVideo();
                }
              });
            }
          },
        },
      });
      players.push(player);
    });
  }

  if ((window as any).YT && (window as any).YT.Player) {
    initYouTubePlayers();
  } else {
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(tag);
    (window as any).onYouTubeIframeAPIReady = initYouTubePlayers;
  }
</script>
