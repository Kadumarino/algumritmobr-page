---
import { siteConfig } from '../data/site';

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumero}?text=${encodeURIComponent(
  siteConfig.whatsappMensagemPadrao
)}`;
---

<a
  class="whatsapp-float"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
>
  <svg viewBox="0 0 32 32" width="30" height="30" fill="#ffffff" aria-hidden="true">
    <path
      d="M16.02 3C9.4 3 4 8.37 4 15c0 2.36.68 4.56 1.86 6.42L4 29l7.77-1.82A11.9 11.9 0 0 0 16.02 27C22.63 27 28 21.63 28 15S22.63 3 16.02 3Zm0 21.6c-1.98 0-3.83-.55-5.4-1.5l-.39-.23-4.6 1.08 1.1-4.48-.25-.4A9.55 9.55 0 0 1 5.4 15c0-5.86 4.76-10.6 10.62-10.6S26.6 9.14 26.6 15 21.88 24.6 16.02 24.6Zm5.83-7.94c-.32-.16-1.88-.93-2.17-1.03-.29-.1-.5-.16-.72.16-.21.32-.82 1.03-1 1.24-.19.21-.37.24-.69.08-.32-.16-1.34-.5-2.55-1.58-.94-.84-1.58-1.87-1.76-2.19-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.55.16-.19.21-.32.32-.53.1-.21.05-.4-.02-.55-.08-.16-.72-1.74-1-2.38-.26-.63-.53-.55-.72-.56h-.62c-.21 0-.55.08-.83.4-.29.32-1.09 1.06-1.09 2.6s1.11 3.02 1.27 3.23c.16.21 2.19 3.35 5.3 4.7.74.32 1.32.51 1.77.65.74.24 1.42.2 1.96.13.6-.09 1.88-.77 2.14-1.51.27-.74.27-1.37.19-1.51-.08-.14-.29-.21-.6-.37Z"
