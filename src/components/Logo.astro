---
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}

const { variant = 'dark', class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const src =
  variant === 'dark'
    ? `${base}images/logo/logo-dark.jpeg`
    : `${base}images/logo/logo-light.jpeg`;
---

<img src={src} alt="Algum Ritmo — Projeto Acústico" class={`site-logo ${className}`} />
