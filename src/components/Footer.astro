---
import Logo from './Logo.astro';
import { siteConfig } from '../data/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumero}?text=${encodeURIComponent(
  siteConfig.whatsappMensagemPadrao
)}`;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-brand-row">
      <a href={base} class="footer-logo-link" aria-label="Algum Ritmo — página inicial">
        <Logo class="footer-logo" />
      </a>
      <p class="footer-tagline">{siteConfig.tagline}</p>
    </div>

    <div class="footer-columns">
      <div class="footer-col">
        <h4>Navegação</h4>
        <ul class="footer-list">
          <li><a href={base}>Início</a></li>
          <li><a href={`${base}sobre/`}>Sobre</a></li>
          <li><a href={`${base}repertorio/`}>Repertório</a></li>
          <li><a href={`${base}agenda/`}>Agenda</a></li>
          <li><a href={`${base}depoimentos/`}>Depoimentos</a></li>
          <li><a href={`${base}book/`}>Book</a></li>
          <li><a href={`${base}contato/`}>Contato</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contato</h4>
        <ul class="footer-list">
          <li><a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
          <li><a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a></li>
          <li><a href={`mailto:${siteConfig.emailContato}`}>E-mail</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} {siteConfig.nome}. Todos os direitos reservados.</p>
  </div>
</footer>
